{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/previews/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/previews/REF-049/:path*",
      "destination": "https://raw.githubusercontent.com/gireeshkumarreddy/streetfighter/731f07c2afccc8046081e2f887e06b22ec61f787/public/:path*"
    },
    {
      "source": "/previews/REF-039/:path*",
      "destination": "https://raw.githubusercontent.com/gireeshkumarreddy/Portfolio2/5ea19735f09187577eb050c493a7a4a989cbcdfd/public/:path*"
    },
    {
      "source": "/previews/REF-010/:path*",
      "destination": "https://raw.githubusercontent.com/gireeshkumarreddy/cinematic-portofilo/e61ebf780d63c8941469e070fe08bd7d261495f4/:path*"
    },
    {
      "source": "/previews/REF-014/:path*",
      "destination": "https://raw.githubusercontent.com/gireeshkumarreddy/Ghost-Rider-/902e1d77b45dcce9ae00abb03b4260b84d289c7b/:path*"
    },
    {
      "source": "/previews/REF-016/:path*",
